# Server
NODE_ENV=development
PORT=5000
API_BASE_URL=/api/v1
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174
COOKIE_SECURE=false
# Optional: hostname only, for example api.example.com. Leave unset for host-only cookies.
COOKIE_DOMAIN=

# PostgreSQL / Prisma
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=60000

# Authentication: replace with long random values outside development
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Redis: stateful workloads (BullMQ, Socket.IO, locks) stay on the primary.
# Cache-only operations can fail over through the optional backups in order.
REDIS_URL_PRIMARY=redis://localhost:6379
REDIS_URL_BACKUP_1=
REDIS_URL_BACKUP_2=
REDIS_URL_BACKUP_3=
# REDIS_URL is still accepted as a legacy alias for REDIS_URL_PRIMARY.

# Google OAuth (optional)
BACKEND_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary (required only for Cloudinary-backed uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (optional; public key may be exposed to the frontend separately)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sportzonebd.com

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sport Zone BD" <no-reply@sportzonebd.com>

# AI descriptions (optional)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_FALLBACK=

# Football data and automation (optional; defaults exist in code)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_HOST=v3.football.api-sports.io
# Legacy single-league default, kept for compatibility. Fixture discovery is driven by
# API_FOOTBALL_LEAGUES below; this value is never used for discovery because it names a
# competition football-data.org already supplies.
API_FOOTBALL_DEFAULT_LEAGUE_ID=39
# Optional shared season for the leagues below. Leave empty to derive each league's season from the
# run date (European seasons straddle two calendar years, MLS and friendlies do not).
API_FOOTBALL_DEFAULT_SEASON=
# Additional football coverage supplied by API-Football, as a comma-separated list of league ids.
# A league may pin its own season with <leagueId>:<season>. football-data.org-owned leagues
# (39, 140, 2, 135, 78, 88, 71, 61, 40, 94) are ignored even if listed, so the Premier League is
# never discovered twice. Default when empty: 15:2025,5,253,307,10
# (FIFA Club World Cup 2025, UEFA Nations League, MLS, Saudi Pro League, International Friendlies).
# Set to `disabled` (also accepted: `off`, `none`) to pause the provider entirely: API-Football then
# makes no request and spends none of the daily quota, while football-data.org and CricketData keep
# running. Nothing is removed from the code, so the provider resumes when this is set back.
API_FOOTBALL_LEAGUES=
# Secondary football provider (API-Football). Free plan allows 100 requests/day.
API_FOOTBALL_DAILY_REQUEST_LIMIT=100
API_FOOTBALL_FIXTURE_CACHE_SECONDS=10800
# An error reported inside the provider's response body (for example a plan/entitlement refusal)
# puts the affected competition out of rotation for this long, so the one-minute discovery
# scheduler cannot spend the daily quota re-asking a competition the provider will not serve.
API_FOOTBALL_ERROR_BACKOFF_SECONDS=21600

# Cricket provider (CricketData.org / CricAPI). Backend only; the key is never sent to the frontend.
CRICKET_API_KEY=
CRICKET_API_BASE_URL=https://api.cricapi.com/v1
CRICKET_MATCHES_ENDPOINT=currentMatches
CRICKET_DAILY_REQUEST_LIMIT=100
CRICKET_FIXTURE_CACHE_SECONDS=7200

APP_TIMEZONE=Asia/Dhaka
# Maximum lead time (days before kickoff) at which automatic match creation is allowed.
MATCH_DISCOVERY_DAYS=7
PRE_MATCH_HEALTH_WINDOW_MINUTES=90
STREAM_HEALTH_TIMEOUT_MS=8000
STREAM_HEALTH_FAILURE_THRESHOLD=3
FINISHED_MATCH_RETENTION_MINUTES=30
DEFAULT_MATCH_DURATION_MINUTES=

# Stream proxy (optional; set PROXY_ALLOWLIST in production when legacy proxy compatibility is needed)
PROXY_ALLOWLIST=
FRONTEND_ORIGIN=http://localhost:5174

# Payments (optional, only when payment integrations are enabled)
BKASH_API_TOKEN=
BKASH_API_URL=
BKASH_APP_KEY=
BKASH_VERIFY_URL=
BKASH_WEBHOOK_SECRET=

# Rate limits (optional)
UPLOAD_RATE_LIMIT=30
PAYMENT_RATE_LIMIT=30
